<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The Mac app is signed with the hardened runtime but is not sandboxed: it
	  opens a folder of markdown files the user already owns, and under the
	  sandbox `~/Documents/Wander` would mean a folder inside the app's own
	  container rather than the one jnl and Nook use.

	  To sandbox it, add:

	      <key>com.apple.security.app-sandbox</key><true/>

	  The two keys below are already what that needs — the store keeps a
	  security-scoped bookmark for any folder chosen in Options ▸ Folder, so the
	  grant survives a relaunch.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>

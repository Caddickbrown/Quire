<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS sandbox (ignored on iOS) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Persist access to a user-chosen journal folder across launches -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- iCloud Documents: journal files live in the app's ubiquity container.
	     The container must be provisioned via Xcode → Signing & Capabilities → iCloud. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.caddickbrown.jibber</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.caddickbrown.jibber</string>
	</array>
</dict>
</plist>

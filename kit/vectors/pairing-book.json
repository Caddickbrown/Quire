{
  "about": "Steps for the pairing book (kit/python/home_pairing_book.py and kit/rust/home-pairing feature \"book\"). Each step calls one method and checks the status and some fields. \"$name\" in args means a value captured earlier; \"capture\" saves fields of the reply. \"advance\" moves the clock first. \"expect\" checks fields by dotted path: a string starting \"^\" is a prefix, \"#n\" is a list length.",
  "service": "test",
  "name": "Test",
  "version": "1.0",
  "steps": [
    {"call": "well_known", "status": 200, "expect": {"service": "test", "pair": "/api/pair", "kinds": ["app"]}},
    {"call": "start", "args": {"data": {"kind": "lamp"}, "ip": "10.0.0.2"}, "status": 400},
    {"call": "start", "args": {"data": {"kind": "app", "code": "ABCDEF"}, "ip": "10.0.0.2"}, "status": 409},
    {"call": "start", "args": {"data": {"kind": "app", "name": "Dan's  iPhone", "model": "iPhone"}, "ip": "10.0.0.2"},
     "status": 200, "expect": {"expires_in": 600, "url": "^https://pi:1/pair?code="},
     "capture": {"code": "code", "token": "token"}},
    {"call": "poll", "args": {"token": "$token", "wait": 0}, "status": 202, "expect": {"waiting": true}},
    {"call": "poll", "args": {"token": "not-a-token", "wait": 0}, "status": 410},
    {"call": "poll", "args": {"token": "", "wait": 0}, "status": 410},
    {"call": "lookup", "args": {"data": {"code": "$code_lower"}, "ip": "10.0.0.9"}, "status": 200,
     "expect": {"request.title": "phone app", "request.name": "Dan's iPhone", "request.model": "iPhone", "request.ip": "10.0.0.2"}},
    {"call": "approve", "args": {"data": {"code": "222222"}, "ip": "10.0.0.9", "approver": "the main token"}, "status": 409},
    {"call": "approve", "args": {"data": {"code": "$code", "scopes": ["admin"]}, "ip": "10.0.0.9", "approver": "the main token"}, "status": 400},
    {"call": "approve", "args": {"data": {"code": "$code", "kind": "pala"}, "ip": "10.0.0.9", "approver": "the main token"}, "status": 409},
    {"call": "approve", "args": {"data": {"code": "$code"}, "ip": "10.0.0.9", "approver": "the main token"}, "status": 200,
     "expect": {"device.name": "Dan's iPhone", "device.scopes": ["read", "write"]}},
    {"call": "approve", "args": {"data": {"code": "$code"}, "ip": "10.0.0.9", "approver": "the main token"}, "status": 409},
    {"call": "poll", "args": {"token": "$token", "wait": 0}, "status": 200,
     "expect": {"key": "^test_app_", "device.id": 1, "device.name": "Dan's iPhone", "scopes": ["read", "write"]},
     "capture": {"key": "key"}},
    {"call": "poll", "args": {"token": "$token", "wait": 0}, "status": 410},
    {"call": "check", "args": {"key": "$key", "ip": "10.0.0.2"}, "result": "ok", "expect": {"id": 1, "scopes": ["read", "write"], "last_ip": "10.0.0.2"}},
    {"call": "check", "args": {"key": "test_app_wrong", "ip": "10.0.0.2"}, "result": "bad"},
    {"call": "listing", "status": 200, "expect": {"paired": "#1", "paired.0.approved_by": "the main token", "paired.0.key": "^test_app_…", "waiting": 0, "locked": false}},
    {"call": "update", "args": {"id": 1, "data": {"scopes": ["read"]}}, "status": 200, "expect": {"scopes": ["read"]}},
    {"call": "update", "args": {"id": 1, "data": {"scopes": ["admin"]}}, "status": 400},
    {"call": "update", "args": {"id": 1, "data": {"name": "  "}}, "status": 400},
    {"call": "update", "args": {"id": 1, "data": {"name": "Desk iPhone"}}, "status": 200, "expect": {"name": "Desk iPhone"}},
    {"call": "update", "args": {"id": 9, "data": {"name": "x"}}, "status": 404},
    {"call": "revoke", "args": {"id": 1}, "status": 200, "expect": {"revoked_at": "^20"}},
    {"call": "check", "args": {"key": "$key", "ip": "10.0.0.2"}, "result": "bad"},
    {"call": "restore", "args": {"id": 1}, "status": 200, "expect": {"revoked_at": null}},
    {"call": "check", "args": {"key": "$key", "ip": "10.0.0.2"}, "result": "ok"},
    {"call": "reload", "note": "a new book on the same file still knows the key"},
    {"call": "check", "args": {"key": "$key", "ip": "10.0.0.2"}, "result": "ok", "expect": {"name": "Desk iPhone"}},

    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.3"}, "status": 200, "capture": {"code": "code", "token": "token"}},
    {"call": "lookup", "args": {"data": {"code": "333333"}, "ip": "10.0.0.66"}, "status": 409},
    {"call": "lookup", "args": {"data": {"code": "333334"}, "ip": "10.0.0.66"}, "status": 409},
    {"call": "lookup", "args": {"data": {"code": "333335"}, "ip": "10.0.0.66"}, "status": 409},
    {"call": "lookup", "args": {"data": {"code": "333336"}, "ip": "10.0.0.66"}, "status": 409},
    {"call": "lookup", "args": {"data": {"code": "333337"}, "ip": "10.0.0.66"}, "status": 409},
    {"call": "approve", "args": {"data": {"code": "$code"}, "ip": "10.0.0.66", "approver": "x"}, "status": 429, "note": "five wrong: this address is locked, even for a right code"},
    {"call": "approve", "args": {"data": {"code": "$code"}, "ip": "10.0.0.9", "approver": "x"}, "status": 200, "expect": {"device.name": "Phone app"}},
    {"call": "advance", "seconds": 601},
    {"call": "lookup", "args": {"data": {"code": "$code"}, "ip": "10.0.0.66"}, "status": 409, "note": "the lock is over, and the code was used"},

    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.4"}, "status": 200, "capture": {"token": "token"}},
    {"call": "advance", "seconds": 601},
    {"call": "poll", "args": {"token": "$token", "wait": 0}, "status": 410, "note": "expired"},

    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 200},
    {"call": "start", "args": {"data": {"kind": "app"}, "ip": "10.0.0.5"}, "status": 429, "note": "ten a minute per address"},
    {"call": "listing", "status": 200, "expect": {"waiting": 10}},

    {"call": "remove", "args": {"id": 1}, "status": 200},
    {"call": "check", "args": {"key": "$key", "ip": "10.0.0.2"}, "result": "bad"},
    {"call": "listing", "status": 200, "expect": {"paired": "#0"}, "note": "the second pairing was approved but never collected, so it never became a key"}
  ]
}

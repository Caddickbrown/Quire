{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wander",
  "version": "0.1.0",
  "identifier": "com.caddickbrown.wander",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "wander",
        "width": 1240,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "backgroundColor": "#F6F2EA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "A journal that writes plain markdown",
    "longDescription": "Wander is a journal and writing app. It stores entries as plain markdown in the jnl layout, so the same folder can be opened by the macOS app, the iOS app, or the jnl CLI."
  }
}
